# Secrets — never commit
.env

# Dependencies
node_modules/

# Confidential recordings and generated output
# NOTE: leading slash anchors this to the repo root (the root audio dir only).
# Without it, the pattern also matched web/src/app/desk/calls/ and silently
# un-tracked the entire /desk/calls route.
/calls/
output/

# macOS
.DS_Store

# Claude Code local settings
.claude/settings.local.json
web/.next.bak*

# Deploy env / secret values — never commit (public repo)
ops/drafts/MONDAY-vercel-env-values.md
.env.local
.env*.local

# Stray macOS duplicate artifacts (e.g. "package 2.json"). web/.engine/ itself is TRACKED.
web/.engine/package 2.json

# iCloud/Finder cloud-sync conflict copies ("foo 2.mjs") — never commit these
* 2.*
* [2-9].*
