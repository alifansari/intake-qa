{
  "name": "intake-qa-concierge",
  "version": "0.1.0",
  "description": "Local CLI: intake-call MP3 -> transcript -> Claude scoring -> HTML report",
  "type": "module",
  "bin": {
    "score": "score.js"
  },
  "scripts": {
    "fake-test": "node fake-test.js",
    "test:v2": "node --no-warnings --test scoring-v2/test/*.test.mjs",
    "smoke:v2": "node scoring-v2/score-v2.js --fixture",
    "e2e-synthetic": "node --no-warnings web/scripts/e2e-synthetic.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "assemblyai": "^4.9.0"
  }
}
