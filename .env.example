# Copy this file to ".env" and paste your real keys after the = signs.
# The .env file is git-ignored and must NEVER be committed or shared.

ASSEMBLYAI_API_KEY=
ANTHROPIC_API_KEY=
# Conservative server-side PII redaction during transcription (SSN, card/banking,
# license/passport only — never names, phones, or case facts). On by default; set
# to "false" to disable.
ASSEMBLYAI_REDACT_PII=
