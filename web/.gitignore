# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# generated weekly reconciliation reports (TEST_MODE renders here)
/output

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example (no real values) MUST be committed so the required vars are visible
!.env.example

# vercel
.vercel

# NOTE: .engine is a committed vendored copy of the repo-root scoring engine +
# data (regenerated by scripts/vendor-engine.mjs on build). It is INTENTIONALLY
# committed — Vercel's Root Directory is `web/`, so the repo-root engine is
# outside the deploy, and build-time vendoring can't be relied on (Vercel may
# run `next build` directly and/or skip postinstall via node_modules cache).
# Committing it guarantees the files exist in the checkout for file tracing.

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev database (SQLite) — generated, may contain data
*.db
*.db-wal
*.db-shm
