# Intake QA (web/) — copy this file to ".env.local" and fill in your values.
# .env.local is git-ignored and must NEVER be committed or shared.

# --- Database + auth (Supabase, hosted product) ---
# Create a Supabase project, run web/supabase/migrations/*.sql, then paste these.
# While blank, the app runs the demo dashboards only; the Approval Queue shows a
# "connect Supabase" state and no login is required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# REQUIRED for the studio + intake surfaces (they query Postgres directly).
# Use the Supabase POOLER connection string (Project Settings -> Database ->
# Connection string -> "Transaction" pooler, port 6543), not the direct 5432
# URL — serverless functions exhaust direct connections. Also read by
# db/migrate-postgres.mjs and db/seed-demo-postgres.mjs.
DATABASE_URL=
# Server-only service-role key — optional: needed only for demo-audio/studio-
# recording uploads (signed Storage; private buckets "demo-audio" and
# "studio-audio"). Firm onboarding works without it. NEVER exposed to the
# browser, NEVER committed.
SUPABASE_SERVICE_ROLE_KEY=

# --- Spot Check Studio (founder-only tool at /studio) ---
# The ONLY email allowed into /studio. Enforced in depth: middleware, every
# studio server action/route (getUser().email === FOUNDER_EMAIL), and Postgres
# RLS. Leave blank in envs where the Studio should be off (it fails closed).
# ACTION FOR ALI: in the Supabase dashboard, Authentication → Providers → Email,
# DISABLE public sign-ups so no one else can self-provision an account. The
# Studio has no public signup UI by design.
FOUNDER_EMAIL=

# --- Transcription & scoring (core engine) ---
ASSEMBLYAI_API_KEY=
ANTHROPIC_API_KEY=
# Conservative server-side PII redaction during transcription (SSN, card/banking,
# license/passport only — never names, phones, or case facts). On by default; set
# to "false" to disable.
ASSEMBLYAI_REDACT_PII=

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# --- E-sign (Dropbox Sign, TEST mode) ---
# Signature requests are ALWAYS created with test_mode:1 — never a live retainer
# until you deliberately go live. Use a SANDBOX API key here.
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_CLIENT_ID=   # app client id — required only for EMBEDDED signing (paid tier)

# --- Email (Resend): daily digests, weekly report, operator alerts ---
# EMAIL_ENABLED is the ONE switch for outbound email. It is deliberately
# separate from TEST_MODE (which arms SMS): turning email on never arms
# texting, and flipping TEST_MODE never turns email on. While EMAIL_ENABLED
# is unset/false (the default) or the keys are blank, every email renders to
# an HTML file under web/output/ instead — nothing is transmitted.
# KILL_SWITCH=true still halts everything, email included.
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=            # verified sender, e.g. "Intake QA <reports@yourdomain.com>"
WEEKLY_REPORT_TO=      # firm recipient for the weekly report
# INTERNAL operator address ONLY (the founder), NEVER a firm contact: this is
# the approval-queue digest. The firm-facing daily digest goes to the firm's
# sign-in emails via /api/digest/run instead. Left blank, the approval-queue
# digest is skipped entirely.
DIGEST_TO=

# --- Billing (Stripe) ---
# Get these from the Stripe Dashboard (Developers -> API keys). Leave BLANK to run
# checkout + webhooks in SIMULATION mode: no real charge, no Stripe call, the flow
# is logged to stripe_sim_log and /api/checkout returns a simulated /welcome URL.
# NEVER commit real keys — env only.
STRIPE_SECRET_KEY=          # sk_live_... or sk_test_...
STRIPE_PUBLISHABLE_KEY=     # pk_live_... or pk_test_... (client-safe)
STRIPE_WEBHOOK_SECRET=      # whsec_... from the webhook endpoint you register
# Stripe Price ids for each flat-monthly plan (create the Products/Prices in the
# dashboard, then paste the price ids here). Amounts live on the Price, never in code.
STRIPE_PRICE_CORE=          # flat $2,500/mo
STRIPE_PRICE_PRO=           # flat $5,000/mo
STRIPE_PRICE_CHARTER=       # flat $1,500/mo intro (steps up to Core after 90 days)
# Absolute app origin used for Checkout success/cancel + magic-link redirects.
APP_URL=https://plaintiffops.com   # canonical origin for Checkout success/cancel + magic-link redirects

# --- Call ingestion (CallRail webhook signature secret) ---
CALLRAIL_WEBHOOK_SECRET=
# Firm id the CallRail/Twilio/voice webhooks attribute calls to (single-tenant
# pilot). Defaults to "1" when blank.
CALLRAIL_FIRM_ID=

# --- Cron + digest (daily desk digest) ---
# Bearer token Vercel Cron sends to /api/digest/run. Any long random string.
CRON_SECRET=
# HMAC secret for signed one-click action links in the digest email. Must be
# at least 16 characters; links are omitted entirely while unset.
DIGEST_LINK_SECRET=

# --- Background jobs (Inngest) ---
# Both come from the Inngest dashboard; read by the SDK behind /api/inngest.
# Signing key authenticates Inngest -> app calls; event key authorizes sends.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# --- Firm integration credentials (at-rest encryption) ---
# Key used to encrypt firm integration credentials (e.g. CallRail API keys)
# before they're stored — never plaintext in the DB. Any long random string;
# /api/settings/integrations refuses to store credentials while unset.
INTEGRATIONS_ENC_KEY=

# --- Audit readout scheduling ---
# Public scheduling link (e.g. Cal.com/Calendly) shown on the audit report page
# so a firm can book their live readout. Button hidden while blank.
AUDIT_CALENDAR_URL=

# --- Pilot flags ---
# "true" routes portal/coach lookups to the single pilot firm when no tenant
# mapping exists yet. Leave blank in multi-tenant environments.
PILOT_SINGLE_TENANT_FALLBACK=
# "true" lets /api/voice/incoming connect a real inbound call to the intake
# agent. Leave blank/false: voice stays off (mock/demo only).
VOICE_ENABLED=
# "true" enables the live intake coach globally for the single-tenant pilot.
LIVE_COACH_ENABLED=
# Public origin of the deployed app (no trailing slash), used to build absolute
# URLs for voice webhooks/streaming, e.g. https://your-app.vercel.app
PUBLIC_APP_URL=

# --- COMPLIANCE CONTROLS (non-negotiable — enforced in the send chokepoint) ---
KILL_SWITCH=true          # true halts ALL sends. Start ON.
TEST_MODE=true            # true = simulate/log sends only; never text real numbers
QUIET_HOURS_START=20      # 8pm — no sends at/after this hour (recipient local time)
QUIET_HOURS_END=8         # 8am — no sends before this hour (recipient local time)
DATA_RETENTION_DAYS=90    # purge transcripts + messages after N days — MUST match the public /security 90-day promise (code default is also 90)
