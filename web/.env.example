# Intake QA (web/) — copy this file to ".env.local" and fill in your values.
# .env.local is git-ignored and must NEVER be committed or shared.

# --- Database + auth (Supabase, hosted product) ---
# Create a Supabase project, run web/supabase/migrations/*.sql, then paste these.
# While blank, the app runs the demo dashboards only; the Approval Queue shows a
# "connect Supabase" state and no login is required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Transcription & scoring (core engine) ---
ASSEMBLYAI_API_KEY=
ANTHROPIC_API_KEY=

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# --- E-sign (Dropbox Sign, TEST mode) ---
# Signature requests are ALWAYS created with test_mode:1 — never a live retainer
# until you deliberately go live. Use a SANDBOX API key here.
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_CLIENT_ID=   # app client id — required only for EMBEDDED signing (paid tier)

# --- Weekly reconciliation email (Resend) ---
# While TEST_MODE=true (or these are blank) the weekly report renders to an HTML
# file under web/output/ instead of emailing — nothing is transmitted.
RESEND_API_KEY=
RESEND_FROM=            # verified sender, e.g. "Intake QA <reports@yourdomain.com>"
WEEKLY_REPORT_TO=      # firm recipient for the weekly report

# --- Call ingestion (CallRail webhook signature secret) ---
CALLRAIL_WEBHOOK_SECRET=

# --- COMPLIANCE CONTROLS (non-negotiable — enforced in the send chokepoint) ---
KILL_SWITCH=true          # true halts ALL sends. Start ON.
TEST_MODE=true            # true = simulate/log sends only; never text real numbers
QUIET_HOURS_START=20      # 8pm — no sends at/after this hour (recipient local time)
QUIET_HOURS_END=8         # 8am — no sends before this hour (recipient local time)
DATA_RETENTION_DAYS=30    # purge transcripts + messages after N days
